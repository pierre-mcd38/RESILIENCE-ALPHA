# ==============================================================================
# PROJECT RESILIENCE-ALPHA — .env.example (Modèle sans secret réel)
# Copier vers .env ou générer via : python scripts/secrets_manager.py render-env
# ==============================================================================

# Réseau Hôte (127.0.0.1 pour tests locaux, 192.168.137.1 sur point d'accès isolé)
HOST_BIND_IP=127.0.0.1
ALLOWED_TARGET_HOSTS=127.0.0.1,192.168.137.1,localhost

# Base de données PostgreSQL (data_net isolé)
POSTGRES_USER=resilience_app
POSTGRES_PASSWORD=PLACEHOLDER_REPLACE_VIA_SECRETS_MANAGER
POSTGRES_DB=resilience_ledger
POSTGRES_PORT=5432

# Authentification JWT (services/auth & services/api)
JWT_SECRET_KEY=PLACEHOLDER_REPLACE_VIA_SECRETS_MANAGER
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600
OPERATOR_DEFAULT_USER=operator_alpha
OPERATOR_DEFAULT_PASSWORD=PLACEHOLDER_REPLACE_VIA_SECRETS_MANAGER
PROBE_SERVICE_USER=resilience_probe
PROBE_SERVICE_PASSWORD=PLACEHOLDER_REPLACE_VIA_SECRETS_MANAGER

# Canal de contrôle HMAC (services/remediator -> services/executor)
EXECUTOR_HMAC_SECRET=PLACEHOLDER_REPLACE_VIA_SECRETS_MANAGER
EXECUTOR_TIMESTAMP_TOLERANCE_SECONDS=30

# Paramètres AIOps & Automate d'incident
ML_MODEL_PATH=/app/ml/artifacts/isolation_forest.joblib
ML_DECISION_THRESHOLD=-0.0850
ML_WINDOW_SECONDS=5
REMEDIATION_MAX_ATTEMPTS=3
REMEDIATION_COOLDOWN_SECONDS=15
WAF_BLOCK_TTL_SECONDS=300

# Observabilité & Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=PLACEHOLDER_REPLACE_VIA_SECRETS_MANAGER

# Assistant RAG Local (Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b
RAG_DOCS_ROOT=/app/docs
